# ---------------------------------------------------------------
# Copy to .env.local (local) and add the same vars in Vercel.
# ---------------------------------------------------------------

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM: any OpenAI-compatible API ---
# xAI Grok (what the original system uses):  https://api.x.ai/v1
# OpenAI:                                    https://api.openai.com/v1
# OpenRouter:                                https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
# Fast model: search intent, titles, outline, section writing, images, categories, tip.
LLM_MODEL_FAST=grok-4-fast-non-reasoning
# Reasoning model: only used to rewrite titles that fail the quality audit.
LLM_MODEL_REASONING=grok-4-fast-reasoning
# Must accept image input. Used to write alt text for generated images.
LLM_MODEL_VISION=grok-4-fast-non-reasoning

# --- Google Programmable Search (SERP research) ---
# API key: https://console.cloud.google.com/apis/credentials (enable "Custom Search API")
# Engine ID: https://programmablesearchengine.google.com (set it to "Search the entire web")
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Admin panel login ---
ADMIN_PASSWORD=
# Any long random string, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# --- Cron ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
CRON_SECRET=
# "true" = posts that pass the quality gate go live automatically.
# Anything else = everything lands as a draft for review (recommended at first).
AUTO_PUBLISH=false
